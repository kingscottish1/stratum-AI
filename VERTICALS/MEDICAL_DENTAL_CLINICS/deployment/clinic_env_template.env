# ============================================================
# CLINIC CLIENT INSTANCE — environment template
# Copy to CLIENT_MANAGEMENT/client_instances/<client>/secrets.env
# and fill real values. NEVER commit real secrets.
# ============================================================

# --- Instance --------------------------------------------------------
CLIENT_ID=client_XXX
VERTICAL=medical_dental_clinics
ENVIRONMENT=production

# --- LLM ---------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FAST_MODEL=gpt-4o-mini
QUALITY_MODEL=gpt-4o

# --- Calendar -----------------------------------------------------------
CALENDAR_MODE=google            # google | pms | dual
GOOGLE_SERVICE_ACCOUNT_FILE=/run/secrets/clinic-google-sa.json
GOOGLE_CALENDAR_ID=

# --- PMS (use the one the clinic runs) ------------------------------------
# Dentrix
DENTRIX_ESERVICES_URL=
DENTRIX_CLINIC_ID=
DENTRIX_API_KEY=
# EagleSoft
EAGLESOFT_API_URL=
EAGLESOFT_API_KEY=
# Simplicity / Open Dental
OPEN_DENTAL_URL=
OPEN_DENTAL_TOKEN=

# --- Insurance verification ------------------------------------------------
INSURANCE_VENDOR=stedi          # stedi | claim.md | mock
INSURANCE_API_URL=
INSURANCE_API_KEY=

# --- Channels ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=             # +1xxxxxxxxxx
TWILIO_WHATSAPP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- CRM / patient comms -------------------------------------------------------
HUBSPOT_API_KEY=                # optional, if clinic uses HubSpot
SLACK_WEBHOOK_URL=              # alerts: human handoffs, errors

# --- Workflow tuning ------------------------------------------------------------
REMINDER_HOURS=48,24
NO_SHOW_WINDOW_HOURS=2
LATE_CANCEL_FEE_WINDOW_HOURS=24
