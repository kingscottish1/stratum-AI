# ============================================================
# BROKERAGE CLIENT INSTANCE — environment template
# Copy to CLIENT_MANAGEMENT/client_instances/<client>/secrets.env
# ============================================================

CLIENT_ID=client_XXX
VERTICAL=real_estate_brokerages
ENVIRONMENT=production

# --- LLM ---------------------------------------------------------------
OPENAI_API_KEY=
FAST_MODEL=gpt-4o-mini
QUALITY_MODEL=gpt-4o

# --- CRM (pick one) -------------------------------------------------------
CRM_PROVIDER=follow_up_boss      # follow_up_boss | kvcore | liondesk | generic
FUB_API_KEY=
RE_CRM_BASE_URL=                 # generic REST CRM
RE_CRM_API_KEY=

# --- MLS ----------------------------------------------------------------
MLS_PROVIDER=resowebapi          # resowebapi | bridge | mock
MLS_API_KEY=
MLS_API_SECRET=
MLS_ENDPOINT=

# --- Zillow leads (optional) ------------------------------------------------
ZILLOW_API_KEY=

# --- Calendar ---------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_CALENDAR_ID=
SHOWING_BUFFER_MINUTES=15
SHOWING_DURATION_MINUTES=45

# --- Channels ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Forms / transactions ------------------------------------------------------
ZIPFORM_API_KEY=
ZIPFORM_ACCOUNT_ID=

# --- Alerts ---------------------------------------------------------------------
SLACK_WEBHOOK_URL=

# --- Tuning ----------------------------------------------------------------------
RESPONSE_SLA_MINUTES=5
HOT_LEAD_THRESHOLD=70
SEQUENCE_ENABLED=true
