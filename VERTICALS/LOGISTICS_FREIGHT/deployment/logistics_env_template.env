# ============================================================
# LOGISTICS CLIENT INSTANCE — environment template
# Copy to CLIENT_MANAGEMENT/client_instances/<client>/secrets.env
# ============================================================

CLIENT_ID=client_XXX
VERTICAL=logistics_freight
ENVIRONMENT=production

# --- LLM ---------------------------------------------------------------
OPENAI_API_KEY=
FAST_MODEL=gpt-4o-mini
QUALITY_MODEL=gpt-4o

# --- TMS (pick one) -------------------------------------------------------
TMS_PROVIDER=tmw               # tmw | fourforce | logistic_manager
TMW_API_URL=
TMW_API_KEY=
FOURFORCE_API_URL=
FOURFORCE_API_KEY=
LOGISTIC_MANAGER_URL=
LOGISTIC_MANAGER_TOKEN=

# --- Accounting (pick one) --------------------------------------------------
ACCOUNTING_PROVIDER=quickbooks  # quickbooks | sageintacct | netsuite
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REALM_ID=
QB_ACCESS_TOKEN=
QB_REFRESH_TOKEN=
INTACCT_SENDER_ID=
INTACCT_COMPANY_ID=
INTACCT_USER_ID=
INTACCT_USER_PASSWORD=
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=

# --- Carrier APIs (as needed) -------------------------------------------------
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
FEDEX_ACCOUNT_NUMBER=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=

# --- WMS (as needed) ------------------------------------------------------------
KINAXIS_URL=
KINAXIS_API_KEY=
KINAXIS_TENANT=
MANHATTAN_URL=
MANHATTAN_CLIENT_ID=
MANHATTAN_CLIENT_SECRET=

# --- Email / alerts ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SLACK_WEBHOOK_URL=

# --- Tuning --------------------------------------------------------------------------
SCAN_GAP_THRESHOLD_HOURS=24
POD_WINDOW_HOURS=48
LATE_TOLERANCE_HOURS=4
AUTO_DISPUTE_LIMIT=500
MATCH_TOLERANCE_PCT=2.0
