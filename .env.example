# ================================================================
# Stratum AI — environment template (BYO everything)
# Copy to .env and fill in YOUR values. NEVER commit .env.
# Generate keys:  python -c "import secrets; print(secrets.token_hex(32))"
# or run:         bash scripts/setup_env.sh
# ================================================================

# --- runtime mode -----------------------------------------------------
# STRATUM_ENV: development | production
# DEMO_MODE:   true  → demo/test mode ONLY (mock connectors, seed data).
#              false → everything real. Mocks refuse to load in production.
STRATUM_ENV=development
DEMO_MODE=false
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------
# SQLite (dev):  sqlite:///./stratum.db
# PostgreSQL:    postgresql+psycopg2://user:pass@host:5432/stratum
DATABASE_URL=sqlite:///./stratum.db

# --- secrets (REQUIRED in production — no defaults, nothing hardcoded) -
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ENCRYPTION_KEY=

# --- BRING YOUR OWN LLM (plug & play) --------------------------------
# Providers: openai | anthropic | azure | openrouter | groq | together
#            | ollama (local, no key) | openai_compatible (any endpoint)
LLM_PROVIDER=openai
LLM_API_KEY=
# Optional overrides:
LLM_BASE_URL=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_QUALITY=gpt-4o
LLM_EMBEDDING_MODEL=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=2048
# Optional failover provider (same key unless you set LLM_FALLBACK_KEY):
LLM_FALLBACK_PROVIDER=
# Extra headers as JSON, e.g. {"HTTP-Referer": "https://stratumai.com"}
LLM_EXTRA_HEADERS=

# --- channel secrets (real integrations) --------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SLACK_SIGNING_SECRET=
SLACK_WEBHOOK_URL=
HUBSPOT_CLIENT_SECRET=
CALENDLY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=

# --- web ----------------------------------------------------------------
CORS_ORIGINS=*
API_PREFIX=/api
TOKEN_TTL_HOURS=8

# --- demo-mode owner account (only used when DEMO_MODE=true) --------------
DEMO_ADMIN_EMAIL=admin@stratum.local
DEMO_ADMIN_PASSWORD=
