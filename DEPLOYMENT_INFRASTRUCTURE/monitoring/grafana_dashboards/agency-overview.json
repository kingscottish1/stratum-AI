{
  "dashboard": {
    "title": "Stratum Platform Overview",
    "uid": "stratum-overview",
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Agent runs per vertical (5m)",
        "type": "timeseries",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum by (vertical) (rate(stratum_agent_runs_total[5m]))",
            "legendFormat": "{{vertical}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 }
      },
      {
        "id": 2,
        "title": "Agent error rate",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum(rate(stratum_agent_runs_total{status="error"}[5m])) / sum(rate(stratum_agent_runs_total[5m]))"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 }
      },
      {
        "id": 3,
        "title": "P95 agent latency (s)",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le) (rate(stratum_agent_duration_seconds_bucket[5m])))"
          }
        ],
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 }
      },
      {
        "id": 4,
        "title": "Active client instances",
        "type": "stat",
        "datasource": "Prometheus",
        "targets": [
          { "expr": "count(stratum_client_instances_active)" }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 }
      },
      {
        "id": 5,
        "title": "Messages per channel (24h)",
        "type": "barchart",
        "datasource": "Prometheus",
        "targets": [
          {
            "expr": "sum by (channel) (increase(stratum_messages_total[24h]))",
            "legendFormat": "{{channel}}"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 }
      }
    ],
    "schemaVersion": 39,
    "tags": ["stratum", "platform"]
  },
  "version": 1
}
